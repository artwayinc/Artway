+}
+
+function getBucket(env: unknown): R2Bucket | null {
+  if (!env || typeof env !== "object") return null;
+  const bucket = (env as Record<string, unknown>).QUOTE_UPLOADS;
+  if (!bucket || typeof (bucket as R2Bucket).put !== "function") return null;
